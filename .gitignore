# Signing secrets — NEVER commit these
*.jks
*.keystore
keystore.properties
!keystore.properties.example

# Other secrets
.env
.env.*
!.env.example
google-services.json

# Build artifacts — rebuildable, and Play Console already holds every release.
# Nine .aab files (281 MB) had been committed here; GitHub warns above 50 MB and
# refuses above 100 MB, so the next release would have been blocked outright.
# They carry no signing key — the .RSA inside is the signature and the public
# certificate — but they do not belong in source control either way.
release_archive/
*.aab
*.apk

# 테스트 산출물 — 매 실행마다 다시 만들어진다.
# 게이트 3-5 의 검증 스크린샷이 저장소 루트에 커밋되어 있어서, QA 를 돌릴 때마다
# PNG 압축 차이로 작업트리가 더러워졌다. 진짜 변경을 가리는 노이즈였다.
test_output/

# 게이트 3-5 가 예전에 저장소 루트에 남기던 검증 스크린샷.
# 이제 test_output/ 으로 나가므로 루트의 사본은 추적하지 않는다.
home_*_verified.png
home_timeattack_ghost_selected.png

# Gemini 의 작업 폴더. 보조 역할이고 앱에 들어가는 코드를 만들지 않는다 —
# 여기 있는 것은 폰 화면 캡처, 구글 문서를 긁어온 텍스트, 그때그때 짠 스크립트다.
# 매번 커밋에서 손으로 빼다가 diff 가 +11,428 줄로 부풀어 실제 변경을 가렸다.
# 파일은 그대로 두고 추적만 하지 않는다 (2026-09-23 사용자 지시).
gemini/
