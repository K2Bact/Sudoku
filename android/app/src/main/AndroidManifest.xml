<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="${appName}"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <meta-data
            android:name="com.google.android.gms.games.APP_ID"
            android:value="@string/game_services_project_id" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="${appName}"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- soundHaptic.js calls navigator.vibrate(); Android silently ignores it
         without this permission, so every haptic in the game did nothing. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- No advertising SDK ships in this build, so nothing here can use the
         advertising ID. The permission was added ahead of AdMob and stayed.

         This is not the same kind of statement as a sentence in the privacy
         policy: Google reads it mechanically, and it drives the advertising-ID
         question on the Data Safety form. A build that tells players no ads are
         served while asking for the advertising ID is two answers to one
         question, and the machine-readable one wins.

         Gate 2-14 case 4b ties this to the gradle dependency and to the policy,
         so all three come back together when advertising goes in:
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" /> -->
</manifest>
