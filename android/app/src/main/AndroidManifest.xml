<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android Auto Backup is off: the only off-device copy is the Play Games saved game
         (cloudSyncService). Two backup paths restored different snapshots on reinstall and
         had to be explained twice in the privacy policy (SudokuDiary ㉖). -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="${appName}"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- This app's own AdMob application id, the one the released app uses. It is
             not a secret (every APK carries it), but it belongs to this app's AdMob
             account. A fork or an outside build puts its own id here, or Google's
             sample id ca-app-pub-3940256099942544~3347511713, which only serves test
             ads; .env.example lists it with the sample unit ids. The app id and the
             unit ids in .env must come from the same AdMob account. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-4962315343548854~7282504859" />

        <meta-data
            android:name="com.google.android.gms.games.APP_ID"
            android:value="@string/game_services_project_id" />

        <!-- Google Analytics for Firebase (2026-10-22). It never reads the advertising ID —
             AdMob uses that, Analytics does not need it, and the policy says so. Every consent
             type starts denied: nothing identifies the install until the ad consent check has
             answered. Outside the regions where Google asks for consent the app grants
             analytics_storage alone (src/services/analyticsConsent.js); inside them it stays
             denied. Ad storage and personalization stay denied — Analytics is not used for ads.
             Gate 2-14 ties these lines to the privacy policy. -->
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_analytics_storage" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_storage" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_user_data" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_personalization_signals" android:value="false" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="${appName}"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <!--
              The smallest window the game is playable in.

              A 9x9 board has to be seen all at once. In a split-screen half of
              about 780x380dp, with the banner at the bottom, the board came out
              132dp across — 15dp cells, which is not a board anyone can read or
              tap (measured, gate 3-12). Declaring the minimum is honest: Android
              then keeps the window at least this big, or letterboxes it, instead
              of the app pretending to fit and handing the player a stamp.

              480dp tall is where the board gets back to about 270dp with the ad
              still in place. 400dp wide is the narrowest phone we support upright.
            -->
            <layout
                android:minWidth="400dp"
                android:minHeight="480dp" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- soundHaptic.js calls navigator.vibrate(); Android silently ignores it
         without this permission, so every haptic in the game did nothing. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
</manifest>
