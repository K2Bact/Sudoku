# Copy this file to `keystore.properties` and fill in the real values.
# `keystore.properties` and *.jks are git-ignored — never commit either.
#
# Alternatively set these environment variables instead:
#   SUIDOKU_STORE_PASSWORD, SUIDOKU_KEY_PASSWORD, SUIDOKU_KEY_ALIAS
#
# storeFile is resolved relative to android/app/

storeFile=suidoku-release-key.jks
storePassword=CHANGE_ME
keyAlias=suidoku-key
keyPassword=CHANGE_ME
