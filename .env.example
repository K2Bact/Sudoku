# Copy to .env and fill in from the Firebase console (Project settings > Your apps),
# or derive from android/app/google-services.json.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Ads ───────────────────────────────────────────────────────────────────
# 'fake' (default) draws a labelled placeholder and touches no network. Keep it
# on for Play closed testing: serving real ads to our own testers is invalid
# traffic, which is how AdMob accounts get suspended.
#
# To go live at real release:
#   1. npm i @capacitor-community/admob && npx cap sync
#   2. fill the three unit ids below from the AdMob console
#   3. set VITE_ADS_PROVIDER=admob
VITE_ADS_PROVIDER=fake
VITE_ADMOB_BANNER_ID=
VITE_ADMOB_INTERSTITIAL_ID=
VITE_ADMOB_REWARDED_ID=
